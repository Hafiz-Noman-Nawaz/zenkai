# Environment Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zenkai_db?schema=public"

# JWT Authentication
JWT_SECRET="zenkai_super_secret_jwt_key_change_in_production_2026"
JWT_EXPIRES_IN="7d"

# Frontend / Client Origin (CORS)
CLIENT_URL="http://localhost:3000"

# External Anime API Config (Optional / Defaults to Jikan v4)
ANIME_API_BASE_URL="https://api.jikan.moe/v4"
